# Default pnpm dev: local UI connected to the existing production API/database.
# API calls and Socket.IO use Vite's same-origin proxy; no database secrets needed.
VITE_LIVE_API_URL=https://backend-production-586c.up.railway.app

# Used only by pnpm dev:full / frontend dev:local.
VITE_DEV_API_TARGET=http://localhost:8081

# Optional browser-facing API origin for a deployed production build.
# Leave blank for local build/preview, which uses the live API proxy.
VITE_API_URL=
